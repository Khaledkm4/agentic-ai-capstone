# Copy to labs/.env and fill in. Never commit .env.

# Required: an OpenRouter key (https://openrouter.ai/keys). Rafeeq uses free models only.
# Without credits a key allows 50 free requests a day; a one-time purchase of 10 credits raises that to 1,000 a day
# (still free models, nothing is spent). Repeated identical requests are served from labs/cache.
OPENROUTER_API_KEY=

# Optional overrides. Rafeeq's defaults (set in capstone/rafeeq/rafeeq.py):
# AGENT_MODEL=nvidia/nemotron-3.5-super-vl:free             # config A, the shipped model
# AGENT_SMALL_MODEL=nvidia/nemotron-3.5-lightning:free      # the eval judge
# AGENT_FALLBACKS=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3.5-lightning:free
# AGENT_CACHE=1                                             # 0 = always call the model
